# ==========================================
# FINDMYFAMILY BACKEND - ENVIRONMENT VARIABLES
# ==========================================
# Copia este archivo a `.env` y RELLENA cada valor marcado como CAMBIAR.
# NUNCA uses los valores de ejemplo tal cual: este archivo es público y
# cualquier secreto escrito aquí se considera comprometido desde el día uno.

# Entorno de ejecución (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# Configuración de Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findmyfamilydb
DB_USER=CAMBIAR
DB_PASSWORD=CAMBIAR

# Cadena de conexión completa (opcional, si se define tiene prioridad)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=findmyfamilydb;Username=CAMBIAR;Password=CAMBIAR

# Configuración de Autenticación JWT
# CAMBIAR: genera un secreto único de al menos 32 bytes aleatorios con:
#   openssl rand -base64 48
# El arranque falla si el secreto mide menos de 32 caracteres o si es este placeholder.
JWT_SECRET=CAMBIAR_GENERAR_CON_openssl_rand_base64_48
JWT_ISSUER=FindMyFamilyApi
JWT_AUDIENCE=FindMyFamilyApp
JWT_EXPIRY_MINUTES=60

# Firebase Cloud Messaging (Silent Push Notifications)
# En Development, si el archivo no existe se activa un mock que NO envía nada.
# En Production el arranque falla si falta: un push silencioso que falla en
# silencio es peor que un error visible.
FIREBASE_CREDENTIALS_PATH=./firebase-admin.json

# Administrador de Sistema inicial (bootstrap). Solo se aplica si no existe ningún admin.
# Imprescindible para el primer arranque: el endpoint que crea usuarios exige ya ser admin.
# Tras crearlo, cambia la contraseña y elimina SUPERADMIN_PASSWORD del entorno.
SUPERADMIN_PHONE=CAMBIAR
SUPERADMIN_PASSWORD=CAMBIAR
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
