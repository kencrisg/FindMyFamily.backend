# ==========================================
# FINDMYFAMILY BACKEND - ENVIRONMENT VARIABLES
# ==========================================
# Copia este archivo a `.env` y RELLENA cada valor marcado como CAMBIAR.
# NUNCA uses los valores de ejemplo tal cual: este archivo es público y
# cualquier secreto escrito aquí se considera comprometido desde el día uno.

# Entorno de ejecución (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# Configuración de Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findmyfamilydb
DB_USER=CAMBIAR
DB_PASSWORD=CAMBIAR

# Cadena de conexión completa (opcional, si se define tiene prioridad)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=findmyfamilydb;Username=CAMBIAR;Password=CAMBIAR

# Configuración de Autenticación JWT
# CAMBIAR: genera un secreto único de al menos 32 bytes aleatorios con:
#   openssl rand -base64 48
# El arranque falla si el secreto mide menos de 32 caracteres o si es este placeholder.
JWT_SECRET=CAMBIAR_GENERAR_CON_openssl_rand_base64_48
JWT_ISSUER=FindMyFamilyApi
JWT_AUDIENCE=FindMyFamilyApp
JWT_EXPIRY_MINUTES=60

# Firebase Cloud Messaging (Silent Push Notifications)
# En Development, si el archivo no existe se activa un mock que NO envía nada.
# En Production el arranque falla si falta: un push silencioso que falla en
# silencio es peor que un error visible.
FIREBASE_CREDENTIALS_PATH=./firebase-admin.json

# Alternativa para despliegues, donde no hay forma cómoda de subir un archivo:
# el CONTENIDO del JSON de la cuenta de servicio, en claro o codificado en base64
#   base64 -i firebase-admin.json | tr -d '\n'
# Si está definida tiene prioridad sobre FIREBASE_CREDENTIALS_PATH. Déjala vacía en local.
FIREBASE_CREDENTIALS_JSON=

# ==========================================
# MIGRACIONES
# ==========================================
# true = la API aplica las migraciones pendientes al arrancar.
# En local déjalo en false y migra a mano, para no cambiar el esquema sin darte cuenta:
#   dotnet ef database update --project FindMyFamily.Infrastructure --startup-project FindMyFamily.Api
# En un hosting gratuito (Render…) ponlo en true: allí no hay dónde ejecutar ese comando.
RUN_MIGRATIONS_ON_STARTUP=false

# ==========================================
# ADMINISTRADOR DE SISTEMA (SUPER ADMIN) INICIAL
# ==========================================
# Para qué sirve: el super admin es el único que puede crear familias y usuarios, y el
# endpoint que crea usuarios exige YA ser super admin. Sin estas variables, una base de
# datos recién creada no tendría forma de dar de alta a nadie.
#
# Cuándo se usa: al arrancar la API, justo después de aplicar las migraciones. Solo crea
# la cuenta si en la base NO existe ningún super admin. Si ya existe, estas variables se
# ignoran por completo: no sirven para crear un segundo admin ni para cambiar la
# contraseña del actual.
#
# Por qué no va dentro de la migración: el repositorio es público, y una migración con el
# super admin dejaría su teléfono y el hash de su contraseña escritos en el código y en el
# SQL que genera `dotnet ef migrations script`. Así los datos solo viven en tu .env.
#
# Primera puesta en marcha:
#   1. Rellena estas variables.
#   2. Crea la base:      dotnet ef database update ...   (o RUN_MIGRATIONS_ON_STARTUP=true)
#   3. Arranca la API. En el log debe aparecer:
#        "Administrador de Sistema inicial creado con el teléfono ..."
#   4. Inicia sesión con ese teléfono y contraseña, y CAMBIA la contraseña.
#   5. Borra SUPERADMIN_PASSWORD de tu .env (y del panel de tu hosting).

# Teléfono con el que iniciará sesión. De 7 a 19 dígitos, con + opcional al principio.
# Se aceptan espacios, guiones y paréntesis: se eliminan al guardarlo (099-900-0001 → 0999000001).
# No puede pertenecer ya a otra cuenta, aunque esté eliminada.
SUPERADMIN_PHONE=CAMBIAR

# Contraseña inicial. Entre 8 y 128 caracteres, con al menos una letra y un número.
# Si no cumple la política, la API se niega a arrancar y te dice por qué.
SUPERADMIN_PASSWORD=CAMBIAR

# Nombre que se mostrará en la app. Opcionales: si faltan se usa "Super Admin".
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
